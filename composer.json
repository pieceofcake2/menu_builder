{
    "name" : "pieceofcake2/menu_builder",
    "description": "Dynamic menu building helper for CakePHP 2 with multi-level and permission based menus",
    "type" : "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "menu", "helper"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "replace": {
        "torifat/cake-menu_builder": "^2.0"
    },
    "autoload-dev": {
        "classmap": ["tests/test_app/"],
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra" : {
        "installer-name" : "MenuBuilder"
    }
}
